# JSONBin.io — shared storage for the courses tree.
# 1. Sign up free at https://jsonbin.io
# 2. Account → API Keys → copy "X-Master-Key" → paste as JSONBIN_API_KEY
# 3. Create a new bin (any JSON content; will be overwritten) → copy its Bin ID
# 4. Add both env vars to Vercel: Project Settings → Environment Variables
JSONBIN_API_KEY=
JSONBIN_BIN_ID=

# Admin credentials. Defaults are used if not set:
#   ADMIN_USER=dipuda007
#   ADMIN_PASS=18122005
ADMIN_USER=dipuda007
ADMIN_PASS=18122005
