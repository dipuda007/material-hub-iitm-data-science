# Vercel Blob — get this by creating a Blob store in Vercel:
# Vercel Dashboard → Storage → Create Database → Blob
# Vercel auto-injects this into your project. Pull locally with:
#   vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=

# Admin credentials. If you don't set these, defaults are used:
#   ADMIN_USER=dipuda007
#   ADMIN_PASS=18122005
ADMIN_USER=dipuda007
ADMIN_PASS=18122005
